# Target and console
CONFIG_IDF_TARGET="esp32"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESPTOOLPY_MONITOR_BAUD_115200B=y

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Partition table with the measurement history partition (FR-7.1)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Network: TCP send buffer of 8 MSS instead of 4, so a long transfer (the
# history CSV, FR-8.6) keeps more data in flight and recovers faster from a
# lost packet. Costs RAM only while data are waiting to be acknowledged.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520

# Network: on a stalled link, memory held by dead connections is freed
# sooner (FR-8.6): SO_LINGER, so the web server can reset a connection whose
# send failed and drop its unsent data, and 6 retransmissions instead of 12
# (a few minutes instead of over 10).
CONFIG_LWIP_SO_LINGER=y
CONFIG_LWIP_TCP_MAXRTX=6

# Wi-Fi: no A-MPDU aggregation when sending (section 6.4). At about -68 dBm
# the link stalled for up to 5 s and then delivered the held packets at once
# (40 to 60 % ping loss); without aggregation the loss dropped to 0 to 10 %.
# The station sends little data, so the lower peak throughput does not matter.
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
