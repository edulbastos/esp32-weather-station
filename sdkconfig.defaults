# Target and console
CONFIG_IDF_TARGET="esp32"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESPTOOLPY_MONITOR_BAUD_115200B=y

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Partition table with the measurement history partition (FR-7.1)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Network: TCP send buffer of 8 MSS instead of 4, so a long transfer (the
# history CSV, FR-8.6) keeps more data in flight and recovers faster from a
# lost packet. Costs RAM only while data are waiting to be acknowledged.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
